#include <Arduino.h>
#include "driver/twai.h"

#define CAN_TX_PIN 21
#define CAN_RX_PIN 22

#define ULTRASONIC_CAN_ID 0x101

#define DISTANCE_THRESHOLD 20.0f

void setup()
{
    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println("====================================");
    Serial.println("SLAVE 2");
    Serial.println("ULTRASONIC SENSOR");
    Serial.println("CAN ID = 0x101");
    Serial.println("125 kbps");
    Serial.println("====================================");

    /* CAN configuration */

    twai_general_config_t g_config =
        TWAI_GENERAL_CONFIG_DEFAULT(
            GPIO_NUM_21,
            GPIO_NUM_22,
            TWAI_MODE_NORMAL
        );

    /* 125 kbps */

    twai_timing_config_t t_config =
        TWAI_TIMING_CONFIG_125KBITS();

    /* Filter ONLY 0x101 */

    twai_filter_config_t f_config =
    {
        .acceptance_code =
            ((uint32_t)ULTRASONIC_CAN_ID << 21),

        .acceptance_mask =
            ~(TWAI_STD_ID_MASK << 21),

        .single_filter = true
    };

    /* Install CAN */

    if (twai_driver_install(
            &g_config,
            &t_config,
            &f_config) != ESP_OK)
    {
        Serial.println("CAN DRIVER INSTALL FAILED");

        while (1)
        {
            delay(1000);
        }
    }

    /* Start CAN */

    if (twai_start() != ESP_OK)
    {
        Serial.println("CAN START FAILED");

        while (1)
        {
            delay(1000);
        }
    }

    Serial.println("CAN STARTED");

    Serial.println("Waiting for Ultrasonic Sensor...");

    Serial.println();
}

void loop()
{
    twai_message_t message;

    if (twai_receive(
            &message,
            pdMS_TO_TICKS(3000)) == ESP_OK)
    {
        if (message.identifier == ULTRASONIC_CAN_ID &&
            message.data_length_code >= 5)
        {
            Serial.println();
            Serial.println("================================");
            Serial.println("   SLAVE 2 - ULTRASONIC SENSOR");
            Serial.println("================================");

            /*
             * Byte 5 indicates whether
             * PSoC successfully read the sensor.
             */

            if (message.data[4] == 0xA5)
            {
                /*
                 * Bytes 0 and 1:
                 * Distance multiplied by 10
                 */

                uint16_t distance10 =
                    ((uint16_t)message.data[0] << 8) |
                    message.data[1];

                float distance =
                    (float)distance10 / 10.0f;

                Serial.println("SENSOR READ : OK");

                Serial.print("CAN ID      : 0x");
                Serial.println(message.identifier, HEX);

                Serial.print("Distance    : ");
                Serial.print(distance, 1);
                Serial.println(" cm");

                /* Obstacle detection */

                if (distance < DISTANCE_THRESHOLD)
                {
                    Serial.println();
                    Serial.println(
                        "!!! OBSTACLE DETECTED !!!"
                    );

                    Serial.println(
                        "WARNING: OBJECT TOO CLOSE"
                    );
                }
                else
                {
                    Serial.println();
                    Serial.println("STATUS : NORMAL");
                }
            }
            else
            {
                Serial.println("SENSOR READ : FAILED");

                Serial.println(
                    "PSoC could not read the Ultrasonic Sensor."
                );
            }

            Serial.println(
                "================================"
            );
        }
    }
}
